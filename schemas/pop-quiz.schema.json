{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "feedback": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "mode": {
      "default": "practice",
      "type": "string",
      "enum": [
        "practice",
        "required"
      ]
    }
  },
  "required": [
    "id",
    "question",
    "choices",
    "answer"
  ],
  "additionalProperties": false
}
