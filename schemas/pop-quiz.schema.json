{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable quiz ID, unique within its exercise.",
      "example": "durable-objects"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "choices": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable choice ID, unique within its quiz.",
            "example": "durable-objects"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "feedback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "label",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "One existing choice ID, not an index. Enforced by supplemental validation.",
      "example": "durable-objects"
    },
    "mode": {
      "default": "practice",
      "description": "Learners can skip practice quizzes. They must answer required quizzes correctly before continuing and can retry after feedback. A correct answer does not verify hands-on work.",
      "type": "string",
      "enum": [
        "practice",
        "required"
      ]
    }
  },
  "required": [
    "id",
    "question",
    "choices",
    "answer"
  ],
  "additionalProperties": false,
  "$comment": "Generated from Zod. Do not edit. See SPEC.md for supplemental cross-field and document constraints. Defaults are annotations, not mutations."
}
